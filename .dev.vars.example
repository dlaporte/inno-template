# Local development environment variables
# Copy this file to .dev.vars and customize for your setup

ENVIRONMENT=dev

# INNO_STORAGE_BASE: base URL for the storage client.
# Leave this UNSET in normal use. The Storage client defaults to
# http://storage.internal, which the gateway intercepts (via the container's
# outbound handler) and routes to the shared R2/D1 backends — this is correct
# both locally (`npm run dev` / `./scripts/dev.sh`) and in production.
# Only set INNO_STORAGE_BASE if you run the app process OUTSIDE the
# container/gateway. Do NOT point it at the gateway's public port.
# INNO_STORAGE_BASE=http://storage.internal
