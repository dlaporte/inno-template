{
  "name": "inno-app-template",
  "main": "src/gateway/index.ts",
  "compatibility_date": "2026-03-10",
  "containers": [
    { "class_name": "AppContainer", "image": "docker.io/alpine:latest", "max_instances": 2, "instance_type": "basic" }
  ],
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "AppContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppContainer"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "inno-template-db", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "inno-template-data" }],
  "vars": { "ACCESS_TEAM_DOMAIN": "davidlaporte.cloudflareaccess.com", "ACCESS_AUD": "template-aud", "ENVIRONMENT": "production" },
  "dev": { "vars": { "ENVIRONMENT": "dev" } }
}
